{
  "version": 2,
  "routes": [
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/site.webmanifest",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/logo.jpeg",
      "dest": "/logo.jpeg"
    },
    {
      "src": "/human.jpeg",
      "dest": "/human.jpeg"
    },
    {
      "src": "/dwarka_catchment_bounds.geojson",
      "dest": "/dwarka_catchment_bounds.geojson"
    },
    {
      "src": "/pothole_depression_registry.json",
      "dest": "/pothole_depression_registry.json"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
